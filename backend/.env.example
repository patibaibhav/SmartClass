APP_ENV=development
DATABASE_URL=postgresql+psycopg2://smartclass:replace-me@127.0.0.1:5432/smartclass
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8443,http://localhost:8443
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_SETUP_TOKEN_EXPIRE_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOW_ATTENDANCE_THRESHOLD=75
# Production requires private Supabase Storage. Do not expose this key to Vercel.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=smartclass-materials
MAX_UPLOAD_BYTES=10485760
DATABASE_SSLMODE=verify-full
